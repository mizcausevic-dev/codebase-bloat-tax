# Public Vite values are embedded in the client bundle. Never put secrets here.
# VITE_GITHUB_OAUTH_CLIENT_ID is a public OAuth client id only. The client secret
# must stay on the server (Netlify function env), never in VITE_*.
VITE_GITHUB_OAUTH_CLIENT_ID=
VITE_GITHUB_OAUTH_ENABLED=false
VITE_APP_SOURCE_VERSION=1.0.0

# Server-only (Netlify / Node). Do not prefix with VITE_.
# GITHUB_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT_URI=
# SESSION_HMAC_SECRET=
